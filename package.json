{
  "name": "rampwatch-app",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "db:generate": "pnpm --filter @sepgate/api db:generate",
    "db:migrate": "pnpm --filter @sepgate/api db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "esbuild", "sharp", "unrs-resolver"]
  }
}
