API_URL=http://localhost:4000
# 32+ random chars — used to encrypt the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Shared secret between apps/web and apps/api for server-to-server calls to
# the operator-scoped API routes. Must match apps/api's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=
