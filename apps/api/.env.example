# Real Postgres connection string. If unset, falls back to an embedded
# PGlite instance under .pglite/ for local dev only — set this for staging/prod.
DATABASE_URL=

PORT=4000

# Comma-separated emails that get role='admin' on signup instead of 'operator'.
ADMIN_EMAILS=

# Shared secret between apps/api and apps/web for server-to-server calls to
# the operator-scoped API routes. Must match apps/web's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=

# The address that receives x402 payments. If unset, a fresh placeholder
# keypair is generated on first run and logged — replace it via
# /admin/pricing before enabling any paid endpoint.
STELLAR_PAYTO_ADDRESS=
X402_FACILITATOR_URL=
X402_NETWORK=stellar:testnet

# SMTP credentials for email alerts (operator alert_configs with channel=email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=
